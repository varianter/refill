---
import RegisterLayout from "../layouts/RegisterLayout.astro";
import RegisterForm from "../components/register/RegisterForm.astro";
---

<RegisterLayout>
  <div class="register_intro">
    <h1>Register</h1>
    <p>
      Refill 2026 is all about friction. In a positive way. Disagreement,
      debate, and differing perspectives make discussions better, not worse. So
      naturally, registering should involve some friction on its own.
    </p>
  </div>

  <RegisterForm />
</RegisterLayout>

<style>
  .register_intro {
    padding-left: var(--Padding-practical);
    padding-right: var(--Padding-practical);
    max-width: 1150px;
    width: 100%;
    margin: auto;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    gap: var(--Padding-s);
  }
</style>
